{
  "name": "gopeptides-backend",
  "version": "1.0.0",
  "description": "GoPeptides e-commerce backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --ignore \"./prisma/**\" --ignore \"./uploads/**\" --ignore \"./assets/**\" --ignore \"./*.png\" --ignore \"./*.db\" src/server.ts",
    "build": "tsc -p tsconfig.json && prisma generate",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "sync:product-images": "tsx scripts/seedProductImages.ts",
    "seed:product-images": "tsx scripts/seedProductImages.ts",
    "generate:labels": "tsx scripts/generateAllLabels.ts",
    "extract:label-pattern": "tsx scripts/extractLabelBottomPattern.ts",
    "seed:labels": "tsx scripts/seedLabelMetadataOnly.ts",
    "check:blog-seo": "tsx scripts/checkBlogPublishGate.ts",
    "check:wallid": "tsx scripts/checkWallidWebhook.ts",
    "check:ecomtrade24": "tsx scripts/checkEcomtrade24Webhook.ts",
    "check:express-eu": "tsx scripts/checkExpressEu.ts",
    "check:product-title-dose": "tsx scripts/checkProductTitleDose.ts",
    "check:aeo": "tsx scripts/checkAeoContent.ts",
    "check:geo": "tsx scripts/checkGeoLlms.ts",
    "check:sitemap-host": "tsx scripts/checkSitemapHost.ts",
    "check:three-tld-seo": "tsx scripts/checkThreeTldSeoFe.ts",
    "check:admin-seo-lang": "tsx scripts/checkAdminSeoLang.ts",
    "check:three-tld-seo-live": "tsx scripts/checkThreeTldSeoLive.ts",
    "check:home-schema": "tsx scripts/checkHomeSchema.ts",
    "seed:blog-research": "tsx scripts/reseedResearchBlogs.ts",
    "seed:product-reviews": "tsx scripts/seedProductReviewsBatch.ts",
    "seed:lab-report-images": "tsx scripts/seedLabReportImages.ts",
    "seed:lab-reports-client-text": "tsx scripts/seedLabReportsClientText.ts",
    "clear:seo-garbage": "tsx scripts/clearAllSeoGarbage.ts",
    "fix:seo-localhost": "tsx scripts/fixLocalhostSeoUrls.ts",
    "seed:seo-metadata": "tsx scripts/seedSeoMetadata.ts",
    "reseed:seo": "tsx scripts/reseedSeo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/dejavu-sans": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.1",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exiftool-vendored": "^36.0.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "image-size": "^2.0.2",
    "indexnow": "^0.1.0",
    "ioredis": "^5.4.1",
    "jsonld": "^9.0.0",
    "jsonwebtoken": "^9.0.2",
    "lighthouse": "^12.8.2",
    "linkinator": "^7.6.1",
    "markdown-it": "^14.2.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.2.0",
    "qrcode": "^1.5.4",
    "reading-time": "^1.5.0",
    "robots-parser": "^3.0.1",
    "schema-dts": "^2.0.0",
    "seo-analyzer": "^3.2.0",
    "sharp": "^0.35.1",
    "sitemap": "^8.0.3",
    "slugify": "^1.6.9",
    "stripe": "^17.4.0",
    "uuid": "^11.0.3",
    "yoastseo": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^10.0.0",
